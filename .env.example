# Public URL used for canonical metadata and local application links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Milestone 3 database templates. Replace only in .env.local; never commit real values.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
DATABASE_ENVIRONMENT=development

# Other provider credentials are intentionally deferred until their owning milestone.
# Never place real secrets in this file.
