# Public URL used for canonical metadata and local application links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Milestone 3 database templates. Replace only in .env.local; never commit real values.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
DATABASE_ENVIRONMENT=development

# Milestone 4 Better Auth. Generate a unique random value locally; never reuse this placeholder.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BEM_ALLOWED_EMAIL_DOMAINS=

# One-time bootstrap inputs for `npm run auth:bootstrap`; set only in .env.local and remove after use.
AUTH_BOOTSTRAP_NAME=
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# Other provider credentials are intentionally deferred until their owning milestone.
# Never place real secrets in this file.
