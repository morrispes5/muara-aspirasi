# Public URL used for canonical metadata and local application links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Official BEM mailbox shown publicly for contact and deletion requests.
NEXT_PUBLIC_BEM_PRIVACY_EMAIL=

# Milestone 3 database templates. Replace only in .env.local; never commit real values.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
DATABASE_ENVIRONMENT=development

# Milestone 4 Better Auth. Generate a unique random value locally; never reuse this placeholder.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BEM_ALLOWED_EMAIL_DOMAINS=

# One-time bootstrap inputs for `npm run auth:bootstrap`; set only in .env.local and remove after use.
AUTH_BOOTSTRAP_NAME=
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# Production bootstrap is a separate one-time procedure; never commit values.
AUTH_PRODUCTION_BOOTSTRAP_CONFIRM=
AUTH_PRODUCTION_BOOTSTRAP_NAME=
AUTH_PRODUCTION_BOOTSTRAP_EMAIL=
AUTH_PRODUCTION_BOOTSTRAP_PASSWORD=

# Milestone 5 anti-spam. Use Cloudflare's official dummy pair only for local/automated testing.
# Never use these test values in production; create separate Turnstile widgets per environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Server-only HMAC salt for pseudonymous public rate-limit and idempotency signals.
# Generate a different random value for each environment; never reuse BETTER_AUTH_SECRET.
PUBLIC_ABUSE_SIGNAL_SECRET=replace-with-a-separate-random-rate-limit-secret

# Evidence storage. Keep the bucket private and configure CORS/lifecycle in the
# Cloudflare dashboard. Set true only after all four R2 values exist in the
# environment secret store; never place real secrets in this file.
R2_EVIDENCE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_EVIDENCE_BUCKET=

# Production enforces TOTP/backup-code enrollment before the admin workspace.
# Keep false locally until the enrollment flow has been exercised.
MFA_REQUIRED=false
# Use report-only for preview/UAT. Production requires enforce after clean QA.
CSP_MODE=report-only

# Internal only. Used by the manually scheduled retention candidate runner;
# keep it unset until an owner configures the job outside the repository.
RETENTION_REVIEW_JOB_SECRET=
