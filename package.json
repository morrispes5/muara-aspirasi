{
  "name": "muara-aspirasi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.mjs",
    "auth:bootstrap": "node --env-file-if-exists=.env.local scripts/auth-bootstrap.mjs",
    "auth:bootstrap:production": "node --env-file-if-exists=.env.local scripts/auth-production-bootstrap.mjs",
    "auth:smoke": "node --env-file-if-exists=.env.local scripts/auth-smoke.mjs",
    "m5:smoke": "node --env-file-if-exists=.env.local scripts/m5-smoke.mjs",
    "test:auth-integration": "node --env-file-if-exists=.env.local scripts/run-auth-integration-tests.mjs",
    "release:preflight": "node --env-file-if-exists=.env.local scripts/release-preflight.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@neondatabase/serverless": "1.1.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "^8.18.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
